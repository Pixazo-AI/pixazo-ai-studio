# ─────────────────────────────────────────────
# Pixazo AI Studio — Environment Variables
# ─────────────────────────────────────────────

# Required: Your Pixazo API subscription key
# Get one at https://www.pixazo.ai/api → Sign up → Copy your key
PIXAZO_API_KEY=your_subscription_key_here

# Optional: Gateway URL (defaults to https://gateway.pixazo.ai)
PIXAZO_GATEWAY_URL=https://gateway.pixazo.ai
